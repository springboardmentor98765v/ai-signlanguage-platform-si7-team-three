# Standalone AI Prediction microservice (SRS Day 5: "Dockerfiles for the
# backend service AND the AI service"). Separate from the main backend's
# Dockerfile - this container only needs the AI service's dependencies,
# not the full backend.

FROM python:3.12-slim

WORKDIR /app

# System deps for future real CV/ML libraries (opencv, mediapipe).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Only install what the AI service needs - not the full backend's requirements.
COPY requirements.txt .
RUN pip install --no-cache-dir fastapi uvicorn pydantic
# When a real model is added, also install its dependencies here, e.g.:
# RUN pip install --no-cache-dir mediapipe opencv-python-headless numpy scikit-learn

COPY app/__init__.py ./app/__init__.py
COPY app/services ./app/services
COPY ai_service ./ai_service

RUN useradd --create-home appuser
USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1

CMD ["uvicorn", "ai_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
