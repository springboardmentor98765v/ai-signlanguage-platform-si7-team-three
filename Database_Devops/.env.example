# Copy this file to .env and adjust values for your environment.
# Never commit a real .env file - it's already covered by .gitignore.

# Database connection string.
# Default (matches docker-compose.yml / SRS Day 2 requirement - PostgreSQL):
DATABASE_URL=postgresql://slp_user:slp_password@localhost:5432/sign_language_platform

# For quick local testing WITHOUT Docker/Postgres, use SQLite instead:
#   DATABASE_URL=sqlite:///./sign_language_platform.db

# Secret key used to sign JWTs. MUST be changed and kept secret in production.
SLP_SECRET_KEY=change-me-to-a-long-random-string

# Only used by docker-compose.yml's postgres service - keep in sync with DATABASE_URL above.
POSTGRES_PASSWORD=slp_password
