# Copy this file to .env and adjust values for your environment.
# Never commit a real .env file - it's already covered by .gitignore.

# Database connection string.
# Default (matches docker-compose.yml / SRS Day 2 requirement - PostgreSQL):
DATABASE_URL=postgresql://slp_user:slp_password@localhost:5432/sign_language_platform

# For quick local testing WITHOUT Docker/Postgres, use SQLite instead:
#   DATABASE_URL=sqlite:///./sign_language_platform.db

# Secret key used to sign JWTs. MUST be changed and kept secret in production.
SLP_SECRET_KEY=change-me-to-a-long-random-string

# Only used by docker-compose.yml's postgres service - keep in sync with DATABASE_URL above.
POSTGRES_PASSWORD=slp_password

# --- Milestone 2 additions ---

# Email settings for "Forgot Password" (SRS Day 2 - Intern 2).
# Per SRS: use either a free Gmail SMTP account (with an App Password,
# NOT your real Gmail password), or set SMTP_ENABLED=false to just print
# the reset link to the console/terminal instead - both are valid for
# Milestone 2, no paid email service needed.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Used to build the password reset link sent to users
# (e.g. https://your-frontend-url.com/reset-password?token=...)
FRONTEND_URL=http://localhost:3000

# Where generated certificate PDFs are saved (SRS Day 7 - Intern 4).
# A local folder is fine for Milestone 2; revisit if moving to free
# cloud storage later.
CERTIFICATE_STORAGE_PATH=./certificates
