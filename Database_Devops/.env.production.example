# Copy this to .env.production and fill in REAL production values.
# .env.production is gitignored - never commit real secrets.

# Real Supabase session pooler connection string (see docs/DEPLOYMENT_READINESS_CHECKLIST.md
# for the exact format that works - direct connection does NOT work from most hosts)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-X-region.pooler.supabase.com:6543/postgres

# Generate a NEW, unique secret for production - do not reuse the dev one
SLP_SECRET_KEY=

# Real frontend production URL once deployed (Day 6)
FRONTEND_URL=

# Email settings if password reset is going live
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

CERTIFICATE_STORAGE_PATH=/app/certificates